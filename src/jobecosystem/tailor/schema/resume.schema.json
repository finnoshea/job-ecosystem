{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobecosystem.local/schema/resume.schema.json",
  "title": "Base resume",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "basics"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "headline": {"type": "string"},
        "email": {"type": "string"},
        "phone": {"type": "string"},
        "location": {"type": "string"},
        "summary": {"type": "string"},
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {"label": {"type": "string"}, "url": {"type": "string"}}
          }
        }
      }
    },
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}},
    "roles": {"type": "array", "items": {"$ref": "#/$defs/role"}},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}},
    "education": {"type": "array", "items": {"$ref": "#/$defs/education"}},
    "certifications": {"type": "array", "items": {"$ref": "#/$defs/certification"}},
    "awards": {"type": "array", "items": {"$ref": "#/$defs/award"}},
    "render": {"$ref": "#/$defs/render"}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
    "bullet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "array", "items": {"type": "string"}},
        "technologies": {"type": "array", "items": {"type": "string"}},
        "priority": {"type": "integer"}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "company", "title"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "company": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "employment_type": {"type": "string"},
        "location": {"type": "string"},
        "start": {"$ref": "#/$defs/date"},
        "end": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "summary": {"type": "string"},
        "bullets": {"type": "array", "items": {"$ref": "#/$defs/bullet"}}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string"},
        "keywords": {"type": "array", "items": {"type": "string"}}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string"},
        "description": {"type": "string"},
        "bullets": {"type": "array", "items": {"$ref": "#/$defs/bullet"}}
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "institution"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "institution": {"type": "string", "minLength": 1},
        "degree": {"type": "string"},
        "field": {"type": "string"},
        "location": {"type": "string"},
        "start": {"$ref": "#/$defs/date"},
        "end": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "details": {"type": "array", "items": {"type": "string"}}
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "issuer": {"type": "string"},
        "date": {"$ref": "#/$defs/date"},
        "url": {"type": "string"}
      }
    },
    "award": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "issuer": {"type": "string"},
        "date": {"$ref": "#/$defs/date"}
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {"type": "string"},
        "section_order": {"type": "array", "items": {"type": "string"}},
        "max_roles": {"type": "integer", "minimum": 1},
        "bullets_per_role": {"type": "integer", "minimum": 1}
      }
    }
  }
}
